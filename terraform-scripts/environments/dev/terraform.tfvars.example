# Copy this file to terraform.tfvars and verify the project ID.
project_id = "project-fd365bc9-bf65-4f05-bfe"
region     = "asia-south1"

cluster_name           = "cn-vul-reg-gke"
artifact_repository_id = "vulnerability-registry"
sql_instance_name      = "vuln-registry-db"
sql_database_name      = "vulnerability_registry"
